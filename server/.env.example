# Web search (see search/index.js)
SEARCH_PROVIDER=serpapi        # serpapi | fake (offline canned results)
SEARCH_TRANSPORT=mcp           # mcp (via mcp-server.js) | direct (in-process)
SEARCH_NUM_RESULTS=5
SEARCH_TIMEOUT_MS=8000         # hybrid mode answers from documents alone past this
SERPAPI_KEY=
# FAKE_SEARCH_MODE=ok          # ok | empty | error | hang

# Services (defaults match docker-compose port mappings for local runs)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentai
CHROMA_URL=http://localhost:8000
REDIS_URL=redis://localhost:6379
PORT=5001

# --- Models -------------------------------------------------------------
# Any OpenAI-compatible server works; switching runtimes is configuration only.
# LLM_RUNTIME selects how "thinking" is disabled: openai | ollama | sglang | vllm

# Local stack (Ollama) — see server/models/*.Modelfile:
#   ollama pull qwen3:8b && ollama pull qwen3-embedding:0.6b
#   ollama create qa-qwen3-8b-32k -f server/models/qwen3-8b-32k.Modelfile
LLM_RUNTIME=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qa-qwen3-8b-32k
# Must match the server's context window; prompts that may not fit are refused.
LLM_CONTEXT_TOKENS=32768
LLM_MAX_OUTPUT_TOKENS=1024
LLM_DISABLE_THINKING=true
LLM_TEMPERATURE=0
LLM_SEED=1
# LLM_TIMEOUT_MS=120000
# LLM_MAX_RETRIES=2

EMBEDDING_MODEL=qwen3-embedding:0.6b
# EMBEDDING_BASE_URL defaults to LLM_BASE_URL
# Ollama fails very large embedding batches (212 inputs failed, 128 worked)
EMBEDDING_BATCH_SIZE=32
EMBEDDING_QUERY_INSTRUCTION="Instruct: Given a web search query, retrieve relevant passages that answer the query\nQuery:"

# Hosted OpenAI instead: leave LLM_BASE_URL unset and set
#   LLM_RUNTIME=openai, LLM_MODEL=gpt-4o, EMBEDDING_MODEL=text-embedding-3-small,
#   EMBEDDING_QUERY_INSTRUCTION=, LLM_CONTEXT_TOKENS=128000, OPENAI_API_KEY=...
# OPENAI_API_KEY=
# LLM_API_KEY is sent to non-OpenAI servers (default "not-needed")

# Eval / benchmark scripts only
SERVER_URL=http://localhost:5001
# EVAL_JUDGE_MODEL defaults to LLM_MODEL
# EVAL_GRADING=judge
